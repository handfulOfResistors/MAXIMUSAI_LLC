# ---------------------------------------------------------------------------
# Javna adresa sajta (bez / na kraju). Koristi se za Stripe success/cancel
# linkove, sitemap i Open Graph. Lokalno: http://localhost:3000
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://maximusai.llc

# ---------------------------------------------------------------------------
# Email (kontakt forma + obaveštenja o pretplatama)
# ---------------------------------------------------------------------------
# Gmail nalog koji šalje poruke
SMTP_USER=adjustrategy@gmail.com
# Google App Password (NE obična lozinka): https://myaccount.google.com/apppasswords
SMTP_PASS=your_16_character_app_password
# Gde stižu poruke sa sajta i obaveštenja o pretplatama
CONTACT_TO=adjustrategy@gmail.com

# ---------------------------------------------------------------------------
# Stripe — https://dashboard.stripe.com/apikeys
# Za testiranje koristi sk_test_... ključ; za pravu naplatu sk_live_...
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_...
# Signing secret webhook-a (whsec_...) — Dashboard → Developers → Webhooks,
# ili ga ispisuje `stripe listen` kod lokalnog testiranja
STRIPE_WEBHOOK_SECRET=whsec_...

# Opciono: link za prijavu u Stripe Customer Portal
# (Dashboard → Settings → Billing → Customer portal → "Login link").
# Kad je popunjen, na sajtu se pojavljuje „Upravljanje pretplatom“.
NEXT_PUBLIC_STRIPE_PORTAL_URL=

# Opciono: "true" = kupac mora da štiklira prihvatanje Uslova korišćenja u Checkout-u.
# Pre uključivanja upiši URL uslova (https://.../terms) u Dashboard → Settings → Public details.
STRIPE_REQUIRE_TOS=false
